generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED

  @@map("user_status")
}

enum Skill {
  LISTENING
  SPEAKING
  READING
  WRITING
  FOUNDATION

  @@map("skill")
}

enum Level {
  A1
  A2
  B1
  B2

  @@map("cefr_level")
}

enum ExerciseStatus {
  DRAFT
  PROPOSED
  PUBLISHED
  HIDDEN

  @@map("exercise_status")
}

enum ExerciseSource {
  ADMIN
  TEACHER
  AI

  @@map("exercise_source")
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique(map: "users_email_key")
  passwordHash String     @map("password_hash")
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE) // giao vien dang ky => PENDING
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  taughtClasses Class[]          @relation("TeacherClasses")
  memberships   ClassMember[]
  exercises     Exercise[]
  assignments   Assignment[]
  attempts      Attempt[]
  skillProfiles SkillProfile[]
  learningPaths LearningPath[]
  notifications Notification[]
  reports       ExerciseReport[]
  aiLogs        AiUsageLog[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Class {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique(map: "classes_code_key")
  teacherId Int      @map("teacher_id")
  teacher   User     @relation("TeacherClasses", fields: [teacherId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  members     ClassMember[]
  assignments Assignment[]

  @@index([teacherId], map: "classes_teacher_id_idx")
  @@map("classes")
}

model ClassMember {
  classId   Int      @map("class_id")
  studentId Int      @map("student_id")
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classId, studentId])
  @@index([studentId], map: "class_members_student_id_idx")
  @@map("class_members")
}

model Exercise {
  id          Int            @id @default(autoincrement())
  type        String
  skill       Skill
  level       Level
  topic       String
  content     Json           @db.JsonB
  answer      Json?          @db.JsonB
  explanation String?
  status      ExerciseStatus @default(DRAFT)
  source      ExerciseSource
  inLibrary   Boolean        @default(false) @map("in_library")
  createdById Int            @map("created_by_id")
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments Assignment[]
  attempts    Attempt[]
  reports     ExerciseReport[]
  pathItems   LearningPathItem[]

  @@index([inLibrary, status, skill, level], map: "exercises_library_filter_idx")
  @@index([createdById], map: "exercises_created_by_id_idx")
  @@map("exercises")
}

model Assignment {
  id            Int      @id @default(autoincrement())
  exerciseId    Int      @map("exercise_id")
  classId       Int      @map("class_id")
  assignedById  Int      @map("assigned_by_id")
  dueAt         DateTime @map("due_at") @db.Timestamptz(3)
  remindBeforeH Int[]    @default([]) @map("remind_before_hours")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  exercise   Exercise  @relation(fields: [exerciseId], references: [id])
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignedBy User      @relation(fields: [assignedById], references: [id])
  attempts   Attempt[]

  @@index([classId, dueAt], map: "assignments_class_due_idx")
  @@index([exerciseId], map: "assignments_exercise_id_idx")
  @@map("assignments")
}

model Attempt {
  id             Int      @id @default(autoincrement())
  studentId      Int      @map("student_id")
  exerciseId     Int      @map("exercise_id")
  assignmentId   Int?     @map("assignment_id")
  mode           String   @default("practice")
  answer         Json     @db.JsonB
  score          Float?
  maxScore       Float    @default(10) @map("max_score")
  errors         Json?    @db.JsonB
  aiFeedback     Json?    @map("ai_feedback") @db.JsonB
  teacherScore   Float?   @map("teacher_score")
  teacherComment String?  @map("teacher_comment")
  isLate         Boolean  @default(false) @map("is_late")
  submittedAt    DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  student    User        @relation(fields: [studentId], references: [id])
  exercise   Exercise    @relation(fields: [exerciseId], references: [id])
  assignment Assignment? @relation(fields: [assignmentId], references: [id])

  @@index([studentId, submittedAt], map: "attempts_student_time_idx")
  @@index([assignmentId], map: "attempts_assignment_id_idx")
  @@index([exerciseId], map: "attempts_exercise_id_idx")
  @@map("attempts")
}

model SkillProfile {
  id         Int      @id @default(autoincrement())
  studentId  Int      @map("student_id")
  skill      Skill
  score      Float    @default(0)
  level      Level?
  errorStats Json?    @map("error_stats") @db.JsonB
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skill], map: "skill_profiles_student_id_skill_key")
  @@map("skill_profiles")
}

model LearningPath {
  id        Int                @id @default(autoincrement())
  studentId Int                @map("student_id")
  weekStart DateTime           @map("week_start") @db.Date
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  student   User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items     LearningPathItem[]

  @@index([studentId, weekStart], map: "learning_paths_student_week_idx")
  @@map("learning_paths")
}

model LearningPathItem {
  id         Int          @id @default(autoincrement())
  pathId     Int          @map("path_id")
  title      String
  exerciseId Int?         @map("exercise_id")
  done       Boolean      @default(false)
  path       LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  exercise   Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([pathId], map: "learning_path_items_path_id_idx")
  @@map("learning_path_items")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  message   String
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "notifications_user_time_idx")
  @@map("notifications")
}

model ExerciseReport {
  id         Int      @id @default(autoincrement())
  exerciseId Int      @map("exercise_id")
  reporterId Int      @map("reporter_id")
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  reporter   User     @relation(fields: [reporterId], references: [id])

  @@index([status], map: "exercise_reports_status_idx")
  @@index([exerciseId], map: "exercise_reports_exercise_idx")
  @@map("exercise_reports")
}

model AiUsageLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  task      String
  status    String
  tokens    Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], map: "ai_usage_logs_user_time_idx")
  @@map("ai_usage_logs")
}

model PromptTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique(map: "prompt_templates_key_key")
  template  String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("prompt_templates")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  detail    Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}
